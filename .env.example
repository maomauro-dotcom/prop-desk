# Copia este archivo a .env y rellena los valores. Nunca subas .env al repo.
# Secreto compartido del webhook de TradingView (va en el JSON como "secret" o en X-Webhook-Secret).
WEBHOOK_SECRET=
# Token del dashboard (Authorization: Bearer <token>). Vacío = todas las rutas /api rechazan.
DASHBOARD_TOKEN=
# Rutas live: en esta versión NO envían órdenes aunque estén en true.
TRADOVATE_ENABLED=false
IB_ENABLED=false
# Filtro Claude opcional (apagado por defecto en el perfil). Sin clave = la señal se rechaza.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_S=8
# anthropic | mcp
CLAUDE_TRANSPORT=anthropic
DATABASE_URL=sqlite:///./propdesk.db
CORS_ORIGINS=http://localhost:3000
